<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget layout rendered via RemoteViews.
    Only a limited subset of Views and attributes are supported by RemoteViews.
    No Compose or data binding here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header row: accent dot + script title -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_accent_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/widget_script_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Script"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Action button (e.g. + Glass) -->
        <TextView
            android:id="@+id/widget_action_button"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="+ Glass"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Run button -->
        <ImageButton
            android:id="@+id/widget_run_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_run_bg"
            android:contentDescription="Run"
            android:src="@drawable/ic_widget_play"
            android:scaleType="center"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:background="#14FFFFFF" />

    <!-- Content area: either rich UI or console output -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Rich UI Container -->
        <LinearLayout
            android:id="@+id/widget_ui_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Big Stat / Metric Value -->
            <TextView
                android:id="@+id/widget_stat_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Subtitle / Badge -->
            <TextView
                android:id="@+id/widget_stat_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:visibility="gone" />

            <!-- Dynamic List Items Container -->
            <LinearLayout
                android:id="@+id/widget_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Dynamic Button in UI container -->
            <TextView
                android:id="@+id/widget_ui_button"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Dynamic multi-button toolbar (e.g. music player, multi-action bar) -->
            <LinearLayout
                android:id="@+id/widget_button_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_btn_1"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/widget_button_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_btn_2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/widget_button_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_btn_3"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/widget_button_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_btn_4"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/widget_button_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- Fallback Console Output Area -->
        <TextView
            android:id="@+id/widget_output"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:text="Tap ▶ to run"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </FrameLayout>

    <!-- Footer: last-run timestamp -->
    <TextView
        android:id="@+id/widget_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="–"
        android:textColor="#40FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
